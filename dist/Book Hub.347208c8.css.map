@keyframes flip {
  0% {
    opacity: 1;
    transform: rotateY(0);
  }

  50% {
    opacity: .6;
    transform: rotateY(-140deg);
  }

  100% {
    opacity: 0;
    transform: rotateY(-160deg);
  }
}

.animate-flip {
  animation: 1.1s ease-in-out infinite flip;
}

.animate-flip-delay-1 {
  animation: 1.1s ease-in-out .15s infinite flip;
}

.animate-flip-delay-2 {
  animation: 1.1s ease-in-out .3s infinite flip;
}

.book-3d {
  perspective: 300px;
}

.page-origin {
  transform-origin: 0;
}
